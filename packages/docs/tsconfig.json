{
  "compilerOptions": {
    "jsx": "preserve",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "moduleResolution": "bundler",
    "module": "esnext",
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "erasableSyntaxOnly": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "@site/*": ["./*"]
    },
    "skipLibCheck": true,
    "types": ["@docusaurus/module-type-aliases", "react", "react-dom"]
  },
  "include": ["src"]
}
