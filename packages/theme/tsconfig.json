{
  "compilerOptions": {
    "target": "es2019",
    "lib": ["dom", "dom.iterable", "es2019"],
    "skipLibCheck": true,
    "strict": true,
    "module": "commonjs",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "noUncheckedSideEffectImports": true,
    "erasableSyntaxOnly": true,
    "isolatedModules": true,
    "isolatedDeclarations": true,
    "noEmitOnError": true,
    "declaration": true,
    "rootDir": "./src",
    "outDir": "./lib",
    "jsx": "react-jsx",
    "types": []
  },
  "include": ["src"],
  "exclude": [
    "node_modules",
    "lib",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/__tests__"
  ]
}
